################################################################################################
# INPUT OPTIONS
################################################################################################
#
# Required:
#   $input                  - Path to the input GDS/OASIS layout file
#   $report                 - Path for the DRC report output file (.lyrdb format)
#
# Optional - Processing Control:
#   $topcell                - Name of the top cell to process (if not specified, uses top cell)
#   $run_mode               - Execution mode: 'tiling', 'deep', or flat (default: flat)
#   $verbose                - Enable verbose output: 'true' or 'false' (default: false)
#
# Optional - Technology Options:
#   $select_decks           - Which deck table to run. If empty run all decks.
#   $variant                - PDK variant to use ('A', 'B', 'C', 'D', 'E', 'F').
#                             Superseeded by metal_level, metal_top and mim_option
#   $metal_level            - Metal stack configuration (default: '5LM')
#                             Options: '3LM', '4LM', '5LM', '6LM'
#   $metal_top              - Top metal thickness (default: '11K')
#   $mim_option             - MIM capacitor option (default: 'B')
#                             Options: 'A' or 'B'
#
# Optional - Rule Enablement (true/false):
#   $feol                   - Enable Front-End-Of-Line rules (default: false)
#   $beol                   - Enable Back-End-Of-Line rules (default: false)
#   $connectivity           - Enable connectivity-based DRC rules (default: false)
#   $offgrid                - Enable off-grid checking (default: false)
#   $slow_via               - Enable slow via rules (default: false)
#   $antenna                - Enable antenna rules (default: false)
#   $density                - Enable density rules (default: false)
#
# Example usage:
#   klayout -b -r gf180mcu_drc.rb -rd input=design.gds -rd report=drc_results.lyrdb \
#           -rd metal_level=5LM -rd feol=true -rd beol=true -rd connectivity=true
#
################################################################################################

#=======================================================================================================================
#--------------------------------------------- GF 0.18um MCU DRC RULE DECK ---------------------------------------------
#=======================================================================================================================
require 'logger'
require 'etc'

# ---- framework ----
require_relative 'rule_framework'

require_relative 'generic_layers'
require_relative 'options'
require_relative 'connectivity'
require_relative 'helper'

exec_start_time = Time.now

logger = Logger.new($stdout)

logger.formatter = proc do |_severity, datetime, _progname, msg|
  "#{datetime}: Memory Usage (" + `pmap #{Process.pid} | tail -1`[10, 40].strip + ") : #{msg}
"
end

#================================================
#----------------- FILE SETUP -------------------
#================================================
logger.info("Starting running GF180MCU Klayout DRC runset on #{$input}")
logger.info("Ruby Version for klayout: #{RUBY_VERSION}")

# As klayout wraps the current code, it is not trivial to access variables from
# the rule files. Hence we define a global here for the registry
Object.const_set(:GF180_DRC_REGISTRY, RuleFramework::Registry.new)

deck_paths = Dir[File.join(__dir__, 'rule_decks', '*.{rb}')]
deck_paths.each { |p| load p }

raw_params = {
  input: $input,
  report: $report,
  topcell: $topcell,
  connectivity: $connectivity,
  offgrid: $offgrid,
  feol: $feol,
  beol: $beol,
  slow_via: $slow_via,
  antenna: $antenna,
  density: $density,
  verbose: $verbose,
  thr: $thr,
  run_mode: $run_mode,
  variant: $variant,
  mim_option: $mim_option,
  metal_top: $metal_top,
  metal_level: $metal_level
}
opts = GF180DRC::Options.from_klayout_params(raw_params: raw_params, registry: GF180_DRC_REGISTRY)
opts.log_to(logger)

if opts.topcell
  source(opts.input.to_s, opts.topcell)
else
  source(opts.input.to_s)
end

report('', opts.report.to_s)

# threads
threads(opts.thr)
# verbose
verbose(opts.verbose?)

# === TILING MODE ===
case opts.run_mode
when 'tiling'
  tiles(500.um)
  tile_borders(10.um)
when 'deep'
  deep
when 'flat'
  flat
else
  warn("Could not recognized run_mode: #{opts.run_mode}")
  exit
end

chip_area = extent.sized(0.0).area
logger.info("Total area of the design is #{chip_area} um^2.")

ctx = RuleFramework::Context.new(drc_engine: self, logger: logger, options: opts)
ctx.extend(GF180DRC::OptionHelpers)

#================================================
#------------- LAYERS DEFINITIONS ---------------
#================================================

GF180DRC::GenericLayers.generate_generic_layers(ctx)

#================================================
#------------- LAYERS CONNECTIONS ---------------
#================================================

if ctx.connectivity? || ctx.antenna?
  logger.info('Construct connectivity for the design.')

  GF180DRC::Connectivity.build(ctx, self)
end

if ctx.connectivity?
  logger.info('Connectivity rules enabled, Netlist object will be generated.')
  netlist
end

#================================================
#----------------- MAIN RUNSET ------------------
#================================================

logger.info('Starting GF180MCU DRC rules.')

if $select_decks
  include_tags = $select_decks.split(',')
  selected_decks = GF180_DRC_REGISTRY.select(include_tags: include_tags)
else
  selected_decks = GF180_DRC_REGISTRY.all
end

logger.info("Selected decks: #{selected_decks.map(&:id).join(', ')}")

# ---- Execute decks ----
logger.info('Starting GF180MCU DRC rules.')
runner = RuleFramework::Runners::Sequential.new(ctx)

runner.run(selected_decks)

exec_end_time = Time.now
run_time = exec_end_time - exec_start_time
logger.info("# DRC Total Run time #{run_time} seconds")
